# Copy to .env.local
# FastAPI backend base URL (run it with: cd backend && .venv/Scripts/uvicorn app.main:app --reload)
NEXT_PUBLIC_API_URL=http://localhost:8000
# true = sign-in/up works without the backend (any email, 8+ char password).
# Leave false to sign in against the real /auth routes.
NEXT_PUBLIC_AUTH_MOCK=false
