# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database ---
# SQLite for local dev; e.g. postgresql+psycopg://user:pass@localhost:5432/cliphive for Postgres
DATABASE_URL=sqlite:///./cliphive.db

# --- Auth (Teammate B) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
MEDIA_DIR=./media
FONTS_DIR=./assets/fonts

# --- Ingestion (Teammate C) ---
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
LIVE_POLL_INTERVAL_S=60
MAX_RECORDING_MINUTES=10

# --- Link / upload imports + Instagram downloader ---
# Leave empty to use ffmpeg on PATH, or the copy bundled with imageio-ffmpeg if there is none.
FFMPEG_PATH=
STORAGE_DIR=storage
# Only the first N minutes of a pasted link or upload are analysed.
MAX_IMPORT_MINUTES=30
MAX_UPLOAD_MB=1024
IMPORT_WORKERS=2
# Netscape cookies.txt from a logged-in browser. Instagram (and some YouTube videos)
# refuse anonymous downloads; with this set, yt-dlp downloads as that account.
YTDLP_COOKIES_FILE=

# --- Transcription via OpenAI (Teammate A) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Keep whisper-1: it is the OpenAI model that returns word-level timestamps
# (response_format=verbose_json, timestamp_granularities=["word"]).
# Uploads are capped at 25 MB, so send extracted audio, not the video file.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Trends (Teammate A) ---
# YouTube Data API v3 key (official search and video metadata/statistics)
YOUTUBE_API_KEY=
TRENDS_CACHE_TTL_S=3600
TRENDS_DEFAULT_REGIONS=NG,US
TRENDS_KEYWORDS=gaming,streaming,Twitch clips,Valorant,Fortnite,FIFA
TRENDS_SCHEDULER_ENABLED=false
TRENDS_MAX_VIDEOS_PER_RUN=60
TRENDS_RECENCY_HALF_LIFE_DAYS=7
# Keep false unless the team has explicit written YouTube approval for these derived metrics.
TRENDS_YOUTUBE_DERIVED_METRICS_APPROVED=false

# --- Posting: native platform APIs (Teammate D) ---
# Base URL that platform OAuth flows redirect back to
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/oauth

# TikTok Content Posting API - https://developers.tiktok.com/apps
# Unaudited apps can only post as private (SELF_ONLY).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# YouTube Data API v3 uploads - OAuth client from https://console.cloud.google.com/apis/credentials
# Default quota allows about 6 uploads/day (1,600 units each of 10,000).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Graph API (Reels) - https://developers.facebook.com/apps
# Needs a Business/Creator account linked to a Facebook Page. 100 posts per 24h.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# X API v2 - https://developer.x.com/en/portal/dashboard (OAuth 1.0a user context for media upload)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# One-click demo login on the sign-in page (demo@cliphive.dev / demo123456). Set false for anything public.
DEMO_LOGIN_ENABLED=true
