# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database ---
# SQLite for local dev; e.g. postgresql+psycopg://user:pass@localhost:5432/cliphive for Postgres
DATABASE_URL=sqlite:///./cliphive.db

# --- Auth (Teammate B) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
MEDIA_DIR=./media
FONTS_DIR=./assets/fonts

# --- Clip Factory: stream monitor (C1) ---
# Optional. With these set, Twitch live checks use the official Helix API; without them we
# fall back to yt-dlp. https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Poll every active streamer this often. A live broadcast is recorded start to finish,
# split into gapless SEGMENT_MINUTES pieces that are clipped as soon as each one completes.
STREAM_MONITOR_ENABLED=true
LIVE_POLL_INTERVAL_S=60
SEGMENT_MINUTES=10
# Safety stop for a single broadcast (0 = keep recording until the stream ends).
MAX_STREAM_HOURS=12
# Broadcasts recorded at the same time.
RECORDING_WORKERS=3
# Clips cut from each segment, and their length in seconds.
SEGMENT_CLIP_COUNT=3
SEGMENT_CLIP_SECONDS=30
# Keep the raw segment files after cutting (a long stream is many GB).
KEEP_RECORDINGS=false

# --- Link / upload imports + Instagram downloader ---
# Leave empty to use ffmpeg on PATH, or the copy bundled with imageio-ffmpeg if there is none.
FFMPEG_PATH=
STORAGE_DIR=storage
# 0 = analyse the whole video. Set N to only analyse the first N minutes of a link or upload.
MAX_IMPORT_MINUTES=0
MAX_UPLOAD_MB=8192
IMPORT_WORKERS=2
# Netscape cookies.txt from a logged-in browser. Instagram (and some YouTube videos)
# refuse anonymous downloads; with this set, yt-dlp downloads as that account.
YTDLP_COOKIES_FILE=
# "Sign in with Google": OAuth 2.0 Web client ID from Google Cloud Console
# (APIs & Services > Credentials). Public by design; leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Optional proxy for platform downloads only, e.g. socks5://127.0.0.1:1080 (from a VPN app's
# proxy mode). Leave empty to use the machine's normal connection.
YTDLP_PROXY=
# YouTube flags IPs that ask too often: YouTube channels' live status is re-checked at most this often.
YOUTUBE_LIVE_POLL_S=300

# --- Video editor ---
# Exports render with the HyperFrames CLI, which needs Node.js 22+ on the server (npx fetches it
# once). The editor's AI chat uses OPENAI_API_KEY / OPENAI_MODEL below.
HYPERFRAMES_VERSION=0.8.189
# draft (fastest) | looks (default) | delivery (best)
EDITOR_RENDER_QUALITY=looks

# --- Transcription via OpenAI (Teammate A) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Keep whisper-1: it is the OpenAI model that returns word-level timestamps
# (response_format=verbose_json, timestamp_granularities=["word"]).
# Uploads are capped at 25 MB, so send extracted audio, not the video file.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Groq (optional): fast hosted Whisper + LLM ---
# https://console.groq.com/keys. With a key, transcription uses Groq's Whisper large-v3
# (local faster-whisper is the fallback) and highlights are ranked by what is said, not
# only by loudness. Leave empty to keep the old behaviour.
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-20b
AI_HIGHLIGHTS_ENABLED=true

# --- Trends (Teammate A) ---
# YouTube Data API v3 key (official search and video metadata/statistics)
YOUTUBE_API_KEY=
TRENDS_CACHE_TTL_S=3600
TRENDS_DEFAULT_REGIONS=NG,US
TRENDS_KEYWORDS=gaming,streaming,Twitch clips,Valorant,Fortnite,FIFA
TRENDS_SCHEDULER_ENABLED=false
TRENDS_MAX_VIDEOS_PER_RUN=60
TRENDS_RECENCY_HALF_LIFE_DAYS=7
# Keep false unless the team has explicit written YouTube approval for these derived metrics.
TRENDS_YOUTUBE_DERIVED_METRICS_APPROVED=false

# --- Posting: native platform APIs (Teammate D) ---
# Base URL that platform OAuth flows redirect back to
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/oauth

# TikTok Content Posting API - https://developers.tiktok.com/apps
# Unaudited apps can only post as private (SELF_ONLY).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# YouTube Data API v3 uploads - OAuth client from https://console.cloud.google.com/apis/credentials
# Default quota allows about 6 uploads/day (1,600 units each of 10,000).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Graph API (Reels) - https://developers.facebook.com/apps
# Needs a Business/Creator account linked to a Facebook Page. 100 posts per 24h.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# X API v2 - https://developer.x.com/en/portal/dashboard (OAuth 1.0a user context for media upload)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# One-click demo login on the sign-in page (demo@cliphive.dev / demo123456). Set false for anything public.
DEMO_LOGIN_ENABLED=true
